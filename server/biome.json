{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
      "enabled": true,
      "rules": {
        "recommended": true,
        "style": {
          "useImportType": "off"
        }
      }
  },
  "assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
  "files": {
    "includes": ["**", "!dist", "!**/dist"]
  }
}
